links:
  - assembly: reactor-unit-reactor-stand
    name: reactor-stand

  - assembly: reactor-unit-pumps-box
    name: pumps-box
    connect:
      withInstance: pumps-box-receiver
      toInstance: pumps-box-mount
      name: reactor-stand

  - assembly: reactor-unit-reactor-core
    name: reactor-core
    connect:
      toInstance: core-holder
      name: reactor-stand
